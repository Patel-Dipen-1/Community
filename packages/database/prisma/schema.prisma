// Prisma Schema for B2B Business Platform
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MANUFACTURER
  DISTRIBUTOR
  WHOLESALER
  TRADER
  RETAILER
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
  BLOCKED
  BLACK
}

enum InquiryStatus {
  PENDING
  QUOTED
  NEGOTIATING
  ACCEPTED
  REJECTED
  CLOSED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id                  String             @id @default(uuid())
  fullName            String
  mobileNumber        String             @unique
  email               String             @unique
  passwordHash        String?
  avatar              String?
  googleId            String?            @unique
  isVerified          Boolean            @default(false)
  status              VerificationStatus @default(UNVERIFIED)
  isDeletionRequested Boolean            @default(false)
  deletionReason      String?
  twoFactorSecret     String?
  isTwoFactorEnabled  Boolean            @default(false)
  
  business            Business?
  sessions            Session[]
  sentMessages        Message[]          @relation("SentMessages")
  conversationsAsUser1 Conversation[]    @relation("User1Conversations")
  conversationsAsUser2 Conversation[]    @relation("User2Conversations")
  
  createdGroups       Group[]            @relation("CreatedGroups")
  groupMemberships    GroupMember[]      @relation("GroupMemberships")
  sentGroupMessages   GroupMessage[]     @relation("SentGroupMessages")
  statuses            Status[]
  statusViews         StatusView[]
  comments            Comment[]
  likes               Like[]
  subscription        UserSubscription?
  paymentTransactions PaymentTransaction[]
  categoryAttributeRequests CategoryAttributeRequest[]
  callsMade           CallLog[]          @relation("CallsMade")
  callsReceived       CallLog[]          @relation("CallsReceived")
  starredMessages     StarredMessage[]
  groupJoinRequests   GroupJoinRequest[]
  pollVotes           PollVote[]
  privacy             UserPrivacy?
  e2eeKey             E2EEKey?
  pushTokens          UserPushToken[]
  createdBroadcastLists BroadcastList[]    @relation("CreatedBroadcastLists")
  broadcastRecipients   BroadcastRecipient[] @relation("UserBroadcastRecipients")
  sentBroadcastMessages BroadcastMessage[] @relation("SentBroadcastMessages")
  broadcastDeliveries   BroadcastDelivery[] @relation("UserBroadcastDeliveries")

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([isDeletionRequested])
  @@index([fullName])
  @@index([status, createdAt])
}

enum GroupRole {
  ADMIN
  MEMBER
}

model Business {
  id                  String             @id @default(uuid())
  userId              String             @unique
  shopName            String
  gstNumber           String?
  streetAddress       String
  city                String
  state               String
  pincode             String
  tradeTerms          String?
  verificationTag     Boolean            @default(false)
  assignedRole        Role?
  allowedCommunities  String[]           // Array of community slugs user is granted access to (e.g. ["clothing", "electronics"])
  
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  media               VerificationMedia[]
  communityMemberships CommunityMember[]
  products            Product[]
  sentInquiries       Inquiry[]          @relation("SentInquiries")
  receivedRfqs        Inquiry[]          @relation("ReceivedInquiries")
  capturedLeads       LeadCapture[]
  statuses            Status[]
  store               Store?
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([shopName])
  @@index([assignedRole])
  @@index([createdAt])
  @@index([assignedRole, createdAt])
}

model Store {
  id          String    @id @default(uuid())
  businessId  String    @unique
  name        String
  slug        String    @unique
  bio         String?
  logoUrl     String?
  bannerUrl   String?
  isActive    Boolean   @default(true)
  
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
}

model VerificationMedia {
  id         String   @id @default(uuid())
  businessId String
  url        String
  mediaType  String   // IMAGE or VIDEO
  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Session {
  id         String        @id @default(uuid())
  userId     String
  token      String        @unique
  deviceId   String?
  platform   String?       // WEB, IOS, ANDROID
  ipAddress  String?
  status     SessionStatus @default(ACTIVE)
  lastActive DateTime      @default(now())
  
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@index([status])
  @@index([lastActive])
  @@index([status, lastActive])
}

model Community {
  id          String            @id @default(uuid())
  slug        String            @unique // "clothing", "jewellery", "electronics"
  name        String            // "Clothing Community", "Jewellery Community", "Electronics"
  description String?
  isActive    Boolean           @default(true)
  
  categories  Category[]
  members     CommunityMember[]
  products    Product[]
  
  createdAt   DateTime          @default(now())
}

model CommunityMember {
  id          String    @id @default(uuid())
  businessId  String
  communityId String
  role        Role
  
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())

  @@unique([businessId, communityId])
}

model Category {
  id          String    @id @default(uuid())
  communityId String
  slug        String    @unique
  name        String
  specFields  Json
  
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  products    Product[]
  
  createdAt   DateTime  @default(now())
}

model Product {
  id           String     @id @default(uuid())
  code         String     @unique
  businessId   String
  communityId  String
  categoryId   String
  title        String
  description  String
  moq          Int        @default(1)
  priceTiers   Json
  images       String[]
  videoUrl     String?
  specs        Json
  isHotSelling Boolean    @default(false)
  isActive     Boolean    @default(true)
  
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  community    Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inquiries    Inquiry[]
  comments     Comment[]
  likes        Like[]
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([businessId])
  @@index([code])
  @@index([isActive])
}

model LeadCapture {
  id              String   @id @default(uuid())
  businessId      String
  creatorUserId   String?
  visitorName     String
  mobileNumber    String
  productCode     String?
  targetCategory  String   @default("clothing")
  message         String?
  quantity        Int?     @default(1)
  status          String   @default("ACTIVE")
  
  batchSize       Int      @default(10)
  currentBatch    Int      @default(1)
  assignedUserIds String[]
  clickedUserIds  String[]
  totalClicks     Int      @default(0)
  
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([businessId])
  @@index([targetCategory])
  @@index([status])
  @@index([createdAt])
}

model Inquiry {
  id           String        @id @default(uuid())
  senderId     String
  receiverId   String
  productId    String?
  quantity     Int
  targetPrice  Float?
  message      String
  status       InquiryStatus @default(PENDING)
  
  sender       Business      @relation("SentInquiries", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     Business      @relation("ReceivedInquiries", fields: [receiverId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id])
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Conversation {
  id        String    @id @default(uuid())
  user1Id   String
  user2Id   String
  user1     User      @relation("User1Conversations", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("User2Conversations", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  senderId        String
  clientMessageId String?
  replyToId       String?
  text            String?
  productCode     String?
  mediaUrl        String?
  isForwarded     Boolean      @default(false)
  forwardCount    Int          @default(0)
  isEdited        Boolean      @default(false)
  isDeleted       Boolean      @default(false)
  status          String       @default("SENT") // SENT, DELIVERED, READ
  reactions       Json?        // Array of { userId: string, emoji: string }
  
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyToMessage  Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("MessageReplies")
  
  createdAt       DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@unique([senderId, clientMessageId])
}

model Group {
  id                      String         @id @default(uuid())
  title                   String
  description             String?
  type                    String         @default("GROUP")
  communitySlug           String         @default("clothing")
  createdById             String
  maxCapacity             Int            @default(40)
  onlyAdminCanPost        Boolean        @default(false)
  hideMemberIdentity      Boolean        @default(true)
  membersCanSeeMemberList Boolean        @default(false)
  isDeleted               Boolean        @default(false)
  inviteToken             String?        @unique
  
  createdBy               User           @relation("CreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)
  members                 GroupMember[]
  messages                GroupMessage[]
  joinRequests            GroupJoinRequest[]
  
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([createdById])
  @@index([communitySlug])
  @@index([isDeleted])
  @@index([createdAt])
}

model GroupMember {
  id          String    @id @default(uuid())
  groupId     String
  userId      String
  roleInGroup GroupRole @default(MEMBER)
  joinedAt    DateTime  @default(now())

  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User      @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([groupId, roleInGroup])
}

model GroupMessage {
  id              String        @id @default(uuid())
  groupId         String
  senderId        String
  clientMessageId String?
  replyToId       String?
  text            String?
  productCode     String?
  mediaUrl        String?
  isForwarded     Boolean       @default(false)
  forwardCount    Int           @default(0)
  isEdited        Boolean       @default(false)
  isDeleted       Boolean       @default(false)
  status          String        @default("SENT")
  reactions       Json?         // Array of { userId: string, emoji: string }
  createdAt       DateTime      @default(now())

  group           Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender          User          @relation("SentGroupMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyToMessage  GroupMessage? @relation("GroupMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         GroupMessage[] @relation("GroupMessageReplies")

  @@index([groupId])
  @@index([groupId, createdAt])
  @@index([groupId, createdAt, id])
  @@index([senderId])
  @@unique([senderId, clientMessageId])
}

model UserBlock {
  id            String   @id @default(uuid())
  blockerId     String
  blockedUserId String
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockerId])
  @@index([blockedUserId])
}

model ConversationSetting {
  id             String   @id @default(uuid())
  userId         String
  conversationId String
  isPinned       Boolean  @default(false)
  isArchived     Boolean  @default(false)
  isMuted        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model Status {
  id           String       @id @default(uuid())
  userId       String
  businessId   String
  caption      String?
  mediaUrl     String?
  mediaType    String       @default("IMAGE") // IMAGE, VIDEO, TEXT
  bgColor      String?
  categories   String[]     // Array of target categories (e.g. ["clothing", "hardware"])
  
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  views        StatusView[]
  comments     Comment[]
  likes        Like[]
  
  createdAt    DateTime     @default(now())
  expiresAt    DateTime?

  @@index([userId])
  @@index([businessId])
  @@index([createdAt])
}

model StatusView {
  id        String   @id @default(uuid())
  statusId  String
  viewerId  String
  viewedAt  DateTime @default(now())

  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
  @@index([statusId])
  @@index([viewerId])
}

model StatusMute {
  id            String   @id @default(uuid())
  userId        String
  mutedUserId   String
  createdAt     DateTime @default(now())

  @@unique([userId, mutedUserId])
  @@index([userId])
  @@index([mutedUserId])
}

model SystemSetting {
  id                                 String   @id @default("default")
  subscriptionSystemEnabled          Boolean  @default(false)
  freeTrialEnabled                   Boolean  @default(true)
  trialExpiryWarningEnabled          Boolean  @default(true)
  paymentEnabled                     Boolean  @default(true)
  renewalEnabled                     Boolean  @default(true)
  subscriptionNotificationsEnabled   Boolean  @default(true)
  subscriptionPopupEnabled          Boolean  @default(true)
  
  // Payment Gateway Controls
  razorpayEnabled                    Boolean  @default(true)
  stripeEnabled                      Boolean  @default(true)
  manualPaymentEnabled               Boolean  @default(true)
  manualPaymentWhatsapp              String   @default("+919999999999")
  
  // Storage Controls
  s3StorageEnabled                   Boolean  @default(false)
  s3BucketName                       String   @default("b2b-media-uploads")
  
  // Two-Factor Auth Super Admin Controls
  twoFactorAuthEnabled               Boolean  @default(false)
  
  // Mobile Push Notification Super Admin Controls
  pushNotificationsEnabled           Boolean  @default(false)
  fcmServerKey                       String?
  
  updatedAt                          DateTime @updatedAt
}

// Mobile Device Push Tokens
model UserPushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("WEB") // WEB, ANDROID, IOS
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model UserSubscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  planName         String             @default("ENTERPRISE_PRO")
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

enum PaymentStatus {
  COMPLETED
  PENDING_VERIFICATION
  DUE
  REJECTED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  MANUAL
}

model PaymentCycle {
  id              String               @id @default(uuid())
  name            String
  durationMonths  Int                  @default(1)
  amount          Float                @default(4999)
  currency        String               @default("INR")
  description     String?
  isActive        Boolean              @default(true)
  
  transactions    PaymentTransaction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([isActive])
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  userId          String
  invoiceNumber   String        @unique
  cycleId         String?
  planName        String        @default("ENTERPRISE_PRO")
  cycleName       String        @default("1st Month Payment")
  amount          Float         @default(4999)
  currency        String        @default("INR")
  paymentMethod   PaymentMethod @default(MANUAL)
  status          PaymentStatus @default(PENDING_VERIFICATION)
  screenshotUrl   String?
  transactionRef  String?
  rejectionReason String?
  paymentDate     DateTime?
  nextDueDate     DateTime?
  
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle           PaymentCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
}

model CategoryAttributeRequest {
  id              String   @id @default(uuid())
  userId          String
  type            String   // CATEGORY, FABRIC, GENDER, FIT, SEASON, SIZE, PATTERN
  value           String
  description     String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Comment {
  id         String   @id @default(uuid())
  userId     String
  statusId   String?
  productId  String?
  text       String
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     Status?  @relation(fields: [statusId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([statusId])
  @@index([productId])
  @@index([userId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  statusId  String?
  productId String?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Status?  @relation(fields: [statusId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([userId, statusId])
  @@unique([userId, productId])
  @@index([statusId])
  @@index([productId])
  @@index([userId])
}

// 1. Interactive In-Chat & Group Polls
model Poll {
  id             String       @id @default(uuid())
  conversationId String?
  groupId        String?
  creatorId      String
  question       String
  allowMultiple  Boolean      @default(false)
  expiresAt      DateTime?
  options        PollOption[]
  votes          PollVote[]
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([groupId])
  @@index([creatorId])
}

model PollOption {
  id     String     @id @default(uuid())
  pollId String
  text   String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String     @id @default(uuid())
  pollId   String
  optionId String
  userId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, userId])
  @@index([pollId])
  @@index([userId])
}

// 2. Starred / Bookmarked Messages
model StarredMessage {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
  @@index([userId])
}

// 3. Group Join Requests & Admin Approval Queue
model GroupJoinRequest {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
}

// 4. LiveKit Call Logs
model CallLog {
  id           String    @id @default(uuid())
  callerId     String
  receiverId   String
  callType     String    // AUDIO, VIDEO
  status       String    // CONNECTED, MISSED, REJECTED, BUSY
  durationSecs Int       @default(0)
  livekitRoom  String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  caller       User      @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  receiver     User      @relation("CallsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
  @@index([startedAt])
}

// 5. User Granular Privacy Settings
model UserPrivacy {
  id           String   @id @default(uuid())
  userId       String   @unique
  lastSeen     String   @default("EVERYONE") // EVERYONE, MY_CONTACTS, NOBODY
  onlineStatus String   @default("EVERYONE") // EVERYONE, SAME_AS_LAST_SEEN
  profilePhoto String   @default("EVERYONE")
  aboutStatus  String   @default("EVERYONE")
  groupAdd     String   @default("EVERYONE")
  callPrivacy  String   @default("EVERYONE")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt
}

// 6. End-to-End Encryption (E2EE) Keys
model E2EEKey {
  id           String   @id @default(uuid())
  userId       String   @unique
  identityKey  String
  signedPreKey String
  oneTimeKeys  Json
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt
}

// 7. Business Quick Replies, Business Hours & Webhooks
model QuickReply {
  id         String   @id @default(uuid())
  businessId String
  shortcut   String
  replyText  String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model BusinessHours {
  id         String   @id @default(uuid())
  businessId String   @unique
  schedule   Json
  isClosed   Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model WebhookConfig {
  id         String       @id @default(uuid())
  businessId String
  targetUrl  String
  secretKey  String
  events     String[]
  isActive   Boolean      @default(true)
  logs       WebhookLog[]

  @@index([businessId])
}

model WebhookLog {
  id           String        @id @default(uuid())
  configId     String
  event        String
  payload      Json
  responseCode Int?
  status       String        // SUCCESS, FAILED
  createdAt    DateTime      @default(now())
  config       WebhookConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

// ============================================================
// DYNAMIC AUTHORIZATION, FEATURE FLAGS, LIMITS & SYSTEM CONTROL
// ============================================================

model FeatureModule {
  id          String    @id @default(uuid())
  key         String    @unique // e.g. "USER_MANAGEMENT", "COMMUNICATION", "COMMERCE"
  name        String
  description String?
  icon        String?   @default("📦")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  features    Feature[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model Feature {
  id              String        @id @default(uuid())
  moduleId        String
  key             String        @unique // e.g. "DIRECT_CHAT", "VOICE_CALLS", "PRODUCTS", "LEADS"
  name            String
  description     String?
  parentKey       String?
  isEnabled       Boolean       @default(true)
  webEnabled      Boolean       @default(true)
  mobileEnabled   Boolean       @default(true)
  adminEnabled    Boolean       @default(true)
  userEnabled     Boolean       @default(true)
  businessEnabled Boolean       @default(true)
  sortOrder       Int           @default(0)
  config          Json?         // Custom JSON configuration/flags
  module          FeatureModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permissions     Permission[]
  limits          PlatformLimit[]
  planFeatures    PlanFeature[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([moduleId])
  @@index([isEnabled])
  @@index([key])
}

model Permission {
  id          String   @id @default(uuid())
  featureKey  String
  key         String   @unique // e.g. "PRODUCT.CREATE", "USER.APPROVE", "CALL.INITIATE"
  name        String
  action      String   // VIEW, CREATE, READ, UPDATE, DELETE, APPROVE, REJECT, VERIFY, MANAGE, EXPORT, IMPORT, ASSIGN, PUBLISH, MODERATE
  description String?
  feature     Feature  @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([featureKey])
  @@index([action])
}

model CustomRole {
  id           String               @id @default(uuid())
  name         String               @unique // e.g. "SUPER_ADMIN", "ADMIN", "BUSINESS", "MODERATOR", "SALES"
  description  String?
  isSystemRole Boolean              @default(false)
  isActive     Boolean              @default(true)
  permissions  RolePermission[]
  roleLimits   RoleLimit[]
  users        UserRoleAssignment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([isActive])
}

model RolePermission {
  id            String     @id @default(uuid())
  roleId        String
  permissionKey String
  featureKey    String
  role          CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@unique([roleId, permissionKey])
  @@index([roleId])
  @@index([permissionKey])
  @@index([featureKey])
}

model UserRoleAssignment {
  id        String     @id @default(uuid())
  userId    String
  roleId    String
  role      CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserPermissionOverride {
  id            String   @id @default(uuid())
  userId        String
  permissionKey String
  featureKey    String
  isGranted     Boolean  @default(true) // true = grant override, false = deny override
  createdAt     DateTime @default(now())

  @@unique([userId, permissionKey])
  @@index([userId])
  @@index([permissionKey])
}

model PlatformLimit {
  id           String      @id @default(uuid())
  featureKey   String
  limitKey     String      @unique // e.g. "GROUP.MAX_MEMBERS", "POST.DAILY_MAX", "PRODUCT.MAX_COUNT", "AUDIO.MAX_DURATION_SECS"
  name         String
  description  String?
  limitType    String      // DAILY, MONTHLY, LIFETIME, CONCURRENT, FILE_SIZE, DURATION, STORAGE, MEMBER
  defaultValue Float       @default(0)
  unit         String      @default("COUNT") // COUNT, SECONDS, MB, BYTES
  isEnabled    Boolean     @default(true) // Dynamic Limit Flag: ON = enforce, OFF = bypass/unrestricted
  feature      Feature     @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  roleLimits   RoleLimit[]
  planLimits   PlanLimit[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([featureKey])
  @@index([limitType])
}

model RoleLimit {
  id        String        @id @default(uuid())
  roleId    String
  limitKey  String
  value     Float
  role      CustomRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  limit     PlatformLimit @relation(fields: [limitKey], references: [limitKey], onDelete: Cascade)

  @@unique([roleId, limitKey])
  @@index([roleId])
  @@index([limitKey])
}

model UserLimitOverride {
  id        String   @id @default(uuid())
  userId    String
  limitKey  String
  value     Float
  isEnabled Boolean? @default(true) // Optional explicit enable/disable for specific user limit
  createdAt DateTime @default(now())

  @@unique([userId, limitKey])
  @@index([userId])
  @@index([limitKey])
}

model ApiRouteFlag {
  id                 String   @id @default(uuid())
  method             String   @default("ALL") // GET, POST, PUT, DELETE, ALL
  path               String   @unique // e.g. "/api/v1/messages", "/api/v1/calls/initiate"
  name               String
  module             String   @default("GENERAL") // AUTH, USER, BUSINESS, CHAT, GROUPS, CALLS, POSTS, PRODUCTS, PAYMENTS
  isEnabled          Boolean  @default(true)
  isRateLimitEnabled Boolean  @default(false)
  rateLimitPerMin    Int      @default(60)
  rateLimitPerHour   Int      @default(1000)
  webEnabled         Boolean  @default(true)
  mobileEnabled      Boolean  @default(true)
  requiredPermission String?
  allowedRoles       Json?    // Optional JSON array of role keys
  allowedPlans       Json?    // Optional JSON array of plan slugs
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([path])
  @@index([module])
  @@index([isEnabled])
}

model UserFeatureOverride {
  id         String   @id @default(uuid())
  userId     String
  featureKey String
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, featureKey])
  @@index([userId])
  @@index([featureKey])
}

model UserApiOverride {
  id        String   @id @default(uuid())
  userId    String
  routePath String
  method    String   @default("ALL")
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, routePath, method])
  @@index([userId])
  @@index([routePath])
}

model DynamicSubscriptionPlan {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique // e.g. "free", "basic", "premium", "enterprise"
  description    String?
  price          Float         @default(0)
  currency       String        @default("INR")
  durationMonths Int           @default(1)
  isActive       Boolean       @default(true)
  isDefault      Boolean       @default(false)
  planFeatures   PlanFeature[]
  planLimits     PlanLimit[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([isActive])
  @@index([slug])
}

model PlanFeature {
  id         String                  @id @default(uuid())
  planId     String
  featureKey String
  isEnabled  Boolean                 @default(true)
  plan       DynamicSubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature    Feature                 @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([planId])
  @@index([featureKey])
}

model PlanLimit {
  id       String                  @id @default(uuid())
  planId   String
  limitKey String
  value    Float
  plan     DynamicSubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  limit    PlatformLimit           @relation(fields: [limitKey], references: [limitKey], onDelete: Cascade)

  @@unique([planId, limitKey])
  @@index([planId])
  @@index([limitKey])
}

model DynamicPlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "PLATFORM_NAME", "LOGO_URL", "MAINTENANCE_MODE", "REGISTRATION_ENABLED"
  category    String   @default("GENERAL") // GENERAL, AUTH, CHAT, CALLING, GROUPS, STORAGE, PAYMENTS, MAINTENANCE
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([key])
}

model AuditLog {
  id             String   @id @default(uuid())
  adminUserId    String
  adminName      String
  action         String   // e.g. "FEATURE_TOGGLED", "ROLE_CREATED", "PERMISSION_CHANGED", "LIMIT_UPDATED"
  targetResource String
  targetId       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([targetResource])
  @@index([createdAt])
}

// ============================================================
// WHATSAPP-STYLE BROADCAST MESSAGING MODELS
// ============================================================

model BroadcastList {
  id          String               @id @default(uuid())
  title       String
  description String?
  creatorId   String
  creator     User                 @relation("CreatedBroadcastLists", fields: [creatorId], references: [id], onDelete: Cascade)
  recipients  BroadcastRecipient[]
  messages    BroadcastMessage[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([creatorId])
  @@index([createdAt])
}

model BroadcastRecipient {
  id              String        @id @default(uuid())
  broadcastListId String
  userId          String
  broadcastList   BroadcastList @relation(fields: [broadcastListId], references: [id], onDelete: Cascade)
  user            User          @relation("UserBroadcastRecipients", fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([broadcastListId, userId])
  @@index([broadcastListId])
  @@index([userId])
}

model BroadcastMessage {
  id              String              @id @default(uuid())
  broadcastListId String
  senderId        String
  text            String?
  productCode     String?
  mediaUrl        String?
  mediaType       String?             // TEXT, EMOJI, IMAGE, VIDEO, DOCUMENT, AUDIO, VOICE, PRODUCT, POST, LINK
  totalRecipients Int                 @default(0)
  pendingCount    Int                 @default(0)
  sentCount       Int                 @default(0)
  deliveredCount  Int                 @default(0)
  failedCount     Int                 @default(0)
  status          String              @default("SENDING") // SENDING, COMPLETED, FAILED, PARTIAL
  broadcastList   BroadcastList       @relation(fields: [broadcastListId], references: [id], onDelete: Cascade)
  sender          User                @relation("SentBroadcastMessages", fields: [senderId], references: [id], onDelete: Cascade)
  deliveries      BroadcastDelivery[]
  createdAt       DateTime            @default(now())

  @@index([broadcastListId])
  @@index([senderId])
  @@index([createdAt])
}

model BroadcastDelivery {
  id                 String           @id @default(uuid())
  broadcastMessageId String
  recipientId        String
  conversationId     String?
  messageId          String?
  status             String           @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  errorReason        String?
  sentAt             DateTime?
  broadcastMessage   BroadcastMessage @relation(fields: [broadcastMessageId], references: [id], onDelete: Cascade)
  recipient          User             @relation("UserBroadcastDeliveries", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([broadcastMessageId, recipientId])
  @@index([broadcastMessageId])
  @@index([recipientId])
  @@index([status])
}










